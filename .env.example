# Public site URL — used for canonical URLs, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery (server-side only — never prefix with NEXT_PUBLIC_).
# When unset, the form validates input but tells visitors that online inquiries are not connected yet.
# Point this at an email service, CRM or automation webhook that accepts JSON POSTs.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
